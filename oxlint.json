{
  "plugins": [
    "typescript"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**"
  ],
  "rules": {
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error"
  }
}
